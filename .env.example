# MongoDB Atlas or local MongoDB connection string. Never commit your real credentials.
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-url>/visioninspect_manufacturing?retryWrites=true&w=majority
DATABASE_NAME=visioninspect_manufacturing

# Frontend API endpoint (FastAPI)
VITE_API_BASE=http://localhost:8000/api

# Optional application settings
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
