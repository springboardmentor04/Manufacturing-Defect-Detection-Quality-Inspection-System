# VisionInspect AI - Backend Environment Template
# Copy this file to .env and replace placeholder values with your local settings.

# FastAPI System Settings
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Security / Authentication (Generate a secure secret key for production)
SECRET_KEY=replace_with_a_secure_random_secret_key_32_bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=visioninspect_db
DATABASE_URL=postgresql://postgres:replace_with_your_postgres_password@localhost:5432/visioninspect_db

# Production AI Model Configuration
MODEL_PATH=runs/detect/yolo_phase4_4_architecture/weights/best.pt
MODEL_IMGSZ=320
MODEL_CONF_THRESHOLD=0.25
MODEL_DEVICE=cpu

# System Logging
LOG_LEVEL=INFO
